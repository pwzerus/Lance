func _initialize() -> void:
	var failed = 0
	for path in PATHS:
		var script = load(path)
		var ok = script != null and script.can_instantiate()
		if not ok: failed += 1
		print("PARSE065 %s %s" % ["OK  " if ok else "FAIL", path])
	print("PARSE065_RESULT failed=%d" % failed)
	quit(1 if failed else 0)
