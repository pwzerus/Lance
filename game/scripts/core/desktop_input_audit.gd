extends Node

# Only instantiated by the explicitly named, unshipped QA executable.
var main: Node
var file: FileAccess
var next_sample = 0
var log_path = "user://qa_desktop_input.jsonl"

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	file = FileAccess.open(log_path,FileAccess.WRITE)
	write({"kind":"begin","build":ProjectSettings.get_setting("application/config/version","unknown"),"source":"Desktop input; no synthetic events generated by this logger"})

func write(data: Dictionary) -> void:
	if not file:
		return
	data["ticks_ms"] = Time.get_ticks_msec()
	file.store_line(JSON.stringify(data))
	file.flush()

func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		write({"kind":"mouse","button":event.button_index,"pressed":event.pressed,"position":event.position})
	elif event is InputEventKey:
		write({"kind":"key","physical":event.physical_keycode,"logical":event.keycode,"pressed":event.pressed,"echo":event.echo})

func _process(_delta: float) -> void:
	if Time.get_ticks_msec()<next_sample:
		return
	next_sample = Time.get_ticks_msec()+100
	if not main.battle:
		return
	var battle = main.battle
	var f = battle.match_model.fighters[0]
	var pose = battle.Model.gait_pose(f)
	write({"kind":"state","phase":battle.match_model.phase,"boost":f.boost,"speed":f.speed,"x":f.x,"stamina":f.stamina,"guard":f.guard,"raw_button":Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT),"paused":battle.paused,"gait":pose.gait,"back_y":pose.offset.y,"rider_y":pose.rider_offset.y,"pitch":pose.pitch,"mouse_held":battle.mouse_held})
